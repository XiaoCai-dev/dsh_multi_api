{
  "name": "dsh_multi_api",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: bind one logical model to several OpenAI-compatible endpoints and fail over automatically on quota exhaustion, rate limits, invalid keys, or upstream errors.",
  "license": "MIT",
  "author": "xcnx666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xcnx666/dsh_multi_api.git"
  },
  "homepage": "https://github.com/xcnx666/dsh_multi_api#readme",
  "bugs": {
    "url": "https://github.com/xcnx666/dsh_multi_api/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "llm",
    "openai-compatible",
    "failover",
    "relay",
    "fallback",
    "model-routing"
  ],
  "type": "module",
  "icon": "icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "docs",
    "DESIGN.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2+": "compatible",
        "0.2.1-rc.2+": "compatible",
        "0.2.2-rc.1+": "compatible"
      }
    }
  }
}
